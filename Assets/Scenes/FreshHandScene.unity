  m_Name: 
  m_EditorClassIdentifier: 
  tipLabel: {fileID: 1986002451}
  textTips:
  - text: "\u6B22\u8FCE\u6765\u5230\u50CF\u7D20\u51B2\u523A"
    appearTime: 2
    duration: 3
  - text: "\u6309\u4E0B W \u6216\u8005 \u2191 \u8FDB\u884C\u8DF3\u8DC3"
    appearTime: 7
    duration: 2
  - text: "\u63A5\u4E0B\u6765\u8BD5\u7740\u8DF3\u8D77\u6765\u5403\u5403\u5E01\u5427~"
    appearTime: 10
    duration: 2
  - text: "\u597D\u5403"
    appearTime: 16
    duration: 2
  - text: "\u8DF3\u8D77\u6765\u5728\u7A7A\u4E2D\u6309 S \u6216 \u2B07\u53EF\u4EE5\u5FEB\u901FMAN"
    appearTime: 20
    duration: 4
  - text: MAN!!
    appearTime: 25
    duration: 2
  - text: "\u4F4D\u4E8E\u7EBF\u5E73\u53F0\u4E0A\u534A\u90E8\u5206\u6309 S \u6216
      \u2B07\u53EF\u4EE5\u7FFB\u8F6C\u5230\u53E6\u4E00\u4FA7"
    appearTime: 30
    duration: 4
  - text: "\u7FFB\u8F6C\u540E\uFF0C\u5BF9\u5E94\u7684\u64CD\u4F5C\u4E5F\u4F1A\u7FFB\u8F6C"
    appearTime: 35
    duration: 3
  - text: "\u5728\u4E0B\u534A\u4FA7\uFF0C\u6309 S \u6216 \u2B07 \u8DF3\u8DC3"
    appearTime: 40
    duration: 3
  - text: "\u5728\u7A7A\u4E2D\u63A7\u5236\u6309 W \u6216 \u2191 \u8FDB\u884CMAN"
    appearTime: 46
    duration: 3
  - text: "\u4F4D\u4E8E\u5E73\u53F0\u4E0A\u65F6\uFF0C\u6309 W \u6216 \u2191 \u7FFB\u8F6C\u56DE\u4E0A\u534A\u4FA7"
    appearTime: 51
    duration: 3
  - text: "\u8EB2\u907F\u671D\u4F60\u88AD\u6765\u7684\u654C\u4EBA\u548C\u5B50\u5F39\uFF0C\u907F\u514D\u88AB\u8098\u51FB"
    appearTime: 56
    duration: 3
  - text: "\u6709\u65F6\u5019\u654C\u4EBA\u53EF\u80FD\u4F1A\u8FC7\u4E8E\uFF1F\uFF01\u5F3A\u5F3A\uFF01\uFF1F"
    appearTime: 65
    duration: 3
  - text: "\u4E0D\u8FC7\u62FE\u53D6\u6280\u80FD\u7403\uFF0C\u4F60\u4E5F\u80FD\u83B7\u5F97\uFF1F\uFF01\u5F3A\u5F3A\uFF1F\uFF01\u7684\u529B\u91CF"
    appearTime: 71
    duration: 3
  - text: "\u7528\uFF1F\uFF01\u5F3A\u5F3A\uFF01\uFF1F\u7684\u529B\u91CF\u51FB\u8D25\u654C\u4EBA\u7F62"
    appearTime: 75
    duration: 3
  - text: "\u65F6\u95F4\u7ED3\u675F\uFF0C\u4F60\u8FC7\u2191\u5173\u2014\u2014\u2014"
    appearTime: 85
    duration: 3
  fadeInTime: 0.5
  fadeOutTime: 0.5
